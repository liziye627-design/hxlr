# Frontend -> Node server bridge
VITE_SERVER_BASE_URL=http://127.0.0.1:3001

# TTS backend bridge
TTS_PROVIDER=unspeech
TTS_PROVIDER_ENDPOINT=http://127.0.0.1:5933/v1/audio/speech
TTS_MODEL=tts-1
TTS_VOICE=alloy
TTS_RESPONSE_FORMAT=mp3
TTS_SPEED=1

# Optional auth for OpenAI-compatible providers
TTS_PROVIDER_API_KEY=

# Minecraft companion bootstrap
MINECRAFT_LOCAL_CONFIG=config/minecraft.local.json
MINECRAFT_BOOTSTRAP_SCRIPT=scripts/start-minecraft-companion.ps1
